[build-system]
requires = ["uv_build>=0.11.21,<0.12.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{module_name}}"

[project]
name = "{{plugin_id}}"
version = "0.1.0"
description = "{{description}}"
readme = "README.md"
requires-python = ">=3.12"

dependencies = [
    "cyberlab",
]

[project.entry-points."cyberlab.plugins"]
"{{plugin_id}}" = "{{module_name}}.plugin:{{class_name}}"
